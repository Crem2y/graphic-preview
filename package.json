{
  "name": "c-array-image-preview",
  "displayName": "C Array Image Preview",
  "description": "Preview 1bpp and RGB565 image arrays directly in C and C++ source code on hover.",
  "version": "1.0.0",
  "publisher": "Crem2y",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test:unit": "npm run compile && node --test test/*.test.cjs",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Crem2y/graphic-preview.git"
  },
  "bugs": {
    "url": "https://github.com/Crem2y/graphic-preview/issues"
  },
  "homepage": "https://github.com/Crem2y/graphic-preview#readme"
}
